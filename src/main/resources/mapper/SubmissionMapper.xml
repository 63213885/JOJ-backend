<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joj.problem.submission.mapper.SubmissionMapper">

    <resultMap id="SubmissionResultMap" type="com.joj.problem.submission.model.Submission">
        <id property="id" column="id"/>

        <result property="userId" column="user_id"/>
        <result property="problemId" column="problem_id"/>
        <result property="contestId" column="contest_id"/>

        <result property="language" column="language"/>
        <result property="code" column="code"/>

        <result property="status" column="status"/>
        <result property="timeUsed" column="time_used"/>
        <result property="memoryUsed" column="memory_used"/>
        <result property="score" column="score"/>

        <result property="submitTime" column="submit_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="isDelete" column="is_delete"/>
    </resultMap>

    <sql id="SubmissionColumns">
        id
        ,
        user_id,
        problem_id,
        contest_id,
        language,
        code,
        status,
        time_used,
        memory_used,
        score,
        submit_time,
        update_time,
        is_delete
    </sql>

    <insert id="insertSubmission" parameterType="com.joj.problem.submission.model.Submission" useGeneratedKeys="true" keyProperty="id">
        insert into submission
        (id,
         user_id,
         problem_id,
         contest_id,
         language,
         code,
         status,
         time_used,
         memory_used,
         score,
         submit_time,
         update_time,
         is_delete)
        values (#{id},
                #{userId},
                #{problemId},
                #{contestId},
                #{language},
                #{code},
                #{status},
                #{timeUsed},
                #{memoryUsed},
                #{score},
                now(3),
                now(3),
                0
               )
    </insert>

    <update id="deleteSubmissionById">
        update submission
        set is_delete = 1, update_time = now(3)
        where id = #{id} and is_delete = 0
    </update>

    <update id="updateSubmissionById" parameterType="com.joj.problem.submission.model.Submission">
        update submission
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="problemId != null">problem_id = #{problemId},</if>
            <if test="contestId != null">contest_id = #{contestId},</if>
            <if test="language != null">language = #{language},</if>
            <if test="code != null">code = #{code},</if>
            <if test="status != null">status = #{status},</if>
            <if test="timeUsed != null">time_used = #{timeUsed},</if>
            <if test="memoryUsed != null">memory_used = #{memoryUsed},</if>
            <if test="score != null">score = #{score},</if>
            <if test="submitTime != null">submit_time = #{submitTime},</if>
            update_time = now(3)
        </set>
        where id = #{id} and is_delete = 0
    </update>

    <select id="getSubmissionById" resultMap="SubmissionResultMap">
        select
        <include refid="SubmissionColumns"/>
        from submission
        where id = #{id} and is_delete = 0
    </select>

    <select id="listSubmissions" parameterType="com.joj.problem.submission.controller.dto.SubmissionQueryRequest" resultMap="SubmissionResultMap">
        select
        <include refid="SubmissionColumns"/>
        from submission
        <trim prefix="where" suffixOverrides="and">
            <if test="userId != null">user_id = #{userId} and</if>
            <if test="problemId != null">problem_id = #{problemId} and</if>
            <if test="contestId != null">contest_id = #{contestId} and</if>
            <if test="language != null and language != ''">language = #{language} and</if>
            <if test="status != null and status != ''">status = #{status} and</if>
            is_delete = 0
        </trim>
        order by submit_time desc
        limit #{limit} offset #{offset}
    </select>

</mapper>