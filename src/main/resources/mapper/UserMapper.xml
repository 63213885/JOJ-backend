<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joj.user.auth.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.joj.user.auth.model.Entity.User">
        <id column="id" property="id"/>

        <result column="account" property="account"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>

        <result column="role" property="role"/>
        <result column="status" property="status"/>

        <result column="avatar_url" property="avatarUrl"/>
        <result column="bio" property="bio"/>
        <result column="school" property="school"/>

        <result column="last_login_time" property="lastLoginTime"/>
        <result column="last_login_ip" property="lastLoginIp"/>

        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_delete" property="isDelete"/>

    </resultMap>

<!--    增-->
    <insert id="insert" parameterType="com.joj.user.auth.model.Entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (account,
                          password_hash,
                          phone,
                          email,
                          role,
                          status,
                          avatar_url,
                          bio,
                          school,
                          last_login_time,
                          last_login_ip,
                          create_time,
                          update_time,
                          is_delete)
        VALUES (#{account},
                #{passwordHash},
                #{phone},
                #{email},
                #{role},
                #{status},
                #{avatarUrl},
                #{bio},
                #{school},
                #{lastLoginTime},
                #{lastLoginIp},
                #{createTime},
                #{updateTime},
                #{isDelete})
    </insert>

<!--    删-->
    <update id="deleteById">
        UPDATE user
        SET is_delete = 1,
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

<!--    改-->
    <update id="updateById" parameterType="com.joj.user.auth.model.Entity.User">
        UPDATE user
        <set>
            <if test="account != null">account = #{account},</if>
            <if test="passwordHash != null">password_hash = #{passwordHash},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="role != null">role = #{role},</if>
            <if test="status != null">status = #{status},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            <if test="bio != null">bio = #{bio},</if>
            <if test="school != null">school = #{school},</if>
            <if test="lastLoginTime != null">last_login_time = #{lastLoginTime},</if>
            <if test="lastLoginIp != null">last_login_ip = #{lastLoginIp},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="isDelete != null">is_delete = #{isDelete},</if>
        </set>
        WHERE id = #{id}
    </update>

<!--    查-->
    <select id="findById" parameterType="long" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE id = #{id}
          AND is_delete = 0 LIMIT 1
    </select>

    <select id="findByAccount" parameterType="string" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE account = #{account}
          AND is_delete = 0 LIMIT 1
    </select>

    <select id="findByPhone" parameterType="string" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE phone = #{phone}
          AND is_delete = 0 LIMIT 1
    </select>

    <select id="findByEmail" parameterType="string" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE email = #{email}
          AND is_delete = 0 LIMIT 1
    </select>

    <select id="existsByAccount" parameterType="string" resultType="boolean">
        SELECT EXISTS(SELECT 1
                      FROM user
                      WHERE account = #{account}
                        AND is_delete = 0
                      )
    </select>
    <select id="existsByPhone" parameterType="string" resultType="boolean">
        SELECT EXISTS(SELECT 1
                      FROM user
                      WHERE phone = #{phone}
                        AND is_delete = 0
                      )
    </select>

    <select id="existsByEmail" parameterType="string" resultType="boolean">
        SELECT EXISTS(SELECT 1
                      FROM user
                      WHERE email = #{email}
                        AND is_delete = 0
                      )
    </select>

    <select id="listByIds" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>